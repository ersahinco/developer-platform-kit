global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: app
    metrics_path: /metrics
    static_configs:
      - targets:
          - app.${dns_namespace}:8000

  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus.${dns_namespace}:9090

  - job_name: loki
    static_configs:
      - targets:
          - loki.${dns_namespace}:3100
