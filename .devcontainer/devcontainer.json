{
  "name": "aws-sdlc-containers",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.9.1": {
      "version": "29.4.1",
      "mobyBuildxVersion": "0.33.0",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/terraform:1.4.2": {
      "version": "1.15.0",
      "tflint": "none",
      "terragrunt": "none"
    },
    "ghcr.io/devcontainers/features/aws-cli:1.1.4": {
      "version": "2.34.39"
    }
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "AWS_REGION": "eu-central-1",
    "BASE_URL": "http://host.docker.internal:8000",
    "DATABASE_URL": "postgresql://postgres:postgres@host.docker.internal:6432/aws_sdlc_containers",
    "BACKFILL_DATABASE_URL": "postgresql://postgres:postgres@host.docker.internal:5432/aws_sdlc_containers",
    "DATA_EXPORT_DATABASE_URL": "postgresql://postgres:postgres@host.docker.internal:5432/aws_sdlc_containers"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "github.vscode-github-actions",
        "hashicorp.terraform",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "standard",
        "ruff.nativeServer": "on"
      }
    }
  },
  "postCreateCommand": "uv sync --all-packages --group dev --group scripts --group test && pre-commit install --hook-type pre-commit --hook-type pre-push",
  "remoteUser": "vscode"
}
