{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aws-sdlc-containers/workload-candidate.schema.json",
  "title": "Workload admission candidate",
  "type": "object",
  "required": [
    "name",
    "kind",
    "use_cases",
    "owner",
    "runtime",
    "operational",
    "image",
    "traces",
    "config"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "kind": {
      "type": "string",
      "enum": ["service", "job"]
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "runtime": {
      "type": "object",
      "required": ["supported", "admitted"],
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "admitted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "operational": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["edge-service", "internal-service", "operator-job", "scheduled-job"]
        },
        "exposure": {
          "type": "string",
          "enum": ["public", "internal"]
        },
        "trigger": {
          "type": "string",
          "enum": ["manual", "schedule"]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "required": ["idempotency"],
      "properties": {
        "idempotency": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["hostname_label", "hostname_label_convention", "auth_mode"],
      "properties": {
        "hostname_label": {
          "type": "string",
          "minLength": 1
        },
        "hostname_label_convention": {
          "type": "string",
          "minLength": 1
        },
        "auth_mode": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["repository", "package", "command"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["format", "required_names"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["prometheus"]
        },
        "required_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "workload_info"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "traces": {
      "type": "object",
      "required": ["supported"],
      "properties": {
        "supported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["semantics", "pooling"],
      "properties": {
        "semantics": {
          "type": "string",
          "enum": ["postgresql"]
        },
        "pooling": {
          "type": "string",
          "enum": ["direct", "transaction_pool"]
        }
      },
      "additionalProperties": false
    },
    "dapr": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "app_id",
            "scope",
            "pubsub_name",
            "topic",
            "subscription_route"
          ],
          "properties": {
            "app_id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "const": "pubsub"
            },
            "pubsub_name": {
              "type": "string",
              "minLength": 1
            },
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "subscription_route": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["app_id", "scope"],
          "properties": {
            "app_id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "const": "service-invocation"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "config": {
      "type": "object",
      "required": ["env", "secrets"],
      "properties": {
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "bounded_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "purpose", "direction", "owner", "config", "evidence"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dns-provider",
              "external-api",
              "external-database",
              "identity-provider",
              "partner-system",
              "saas-api"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": ["inbound", "outbound", "bidirectional"]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "config": {
            "type": "object",
            "required": ["env", "secrets"],
            "properties": {
              "env": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "uniqueItems": true
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "service"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["service", "metrics"],
        "properties": {
          "operational": {
            "properties": {
              "class": {
                "enum": ["edge-service", "internal-service"]
              }
            }
          }
        },
        "not": {
          "required": ["job"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "service"
          },
          "operational": {
            "properties": {
              "class": {
                "const": "edge-service"
              }
            },
            "required": ["class"]
          }
        },
        "required": ["kind", "operational"]
      },
      "then": {
        "required": ["edge"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "job"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["job"],
        "properties": {
          "operational": {
            "required": ["trigger"],
            "properties": {
              "class": {
                "enum": ["operator-job", "scheduled-job"]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["service"]
            },
            {
              "required": ["edge"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operational": {
            "properties": {
              "class": {
                "const": "operator-job"
              }
            },
            "required": ["class"]
          }
        },
        "required": ["operational"]
      },
      "then": {
        "properties": {
          "operational": {
            "properties": {
              "trigger": {
                "const": "manual"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operational": {
            "properties": {
              "class": {
                "const": "scheduled-job"
              }
            },
            "required": ["class"]
          }
        },
        "required": ["operational"]
      },
      "then": {
        "properties": {
          "operational": {
            "properties": {
              "trigger": {
                "const": "schedule"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
