{
  "schema_version": "2",
  "defaults": {
    "env": {
      "DB_PORT": "5432",
      "DB_USER": "postgres",
      "DB_NAME": "aws_sdlc_containers"
    },
    "secrets": {
      "DB_PASSWORD": "runtime-secret://postgres-password"
    }
  },
  "workloads": {
    "api": {
      "startup_timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@pgbouncer:5432/aws_sdlc_containers",
        "OTEL_TRACES_ENABLED": "false",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://127.0.0.1:4318/v1/traces",
        "OTEL_SERVICE_NAME": "aws-sdlc-containers-api-conformance",
        "OTEL_DEPLOYMENT_ENVIRONMENT": "conformance",
        "ROLLOUT_DRILL_FAULT_MODE": "off",
        "ROLLOUT_DRILL_FAULT_PATHS": "/ready",
        "ROLLOUT_DRILL_FAULT_STATUS_CODE": "503",
        "ROLLOUT_DRILL_FAULT_DELAY_SECONDS": "3"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "request_id", "route", "status_code"]
    },
    "event_consumer": {
      "startup_timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "DAPR_HTTP_ENDPOINT": "http://127.0.0.1:3500",
        "DAPR_HTTP_PORT": "3500",
        "EVENT_CONSUMER_APP_PORT": "8081",
        "EVENT_CONSUMER_WORKER_MODE": "consumer",
        "EVENT_CONSUMER_WORKER_RUN_ONCE": "false",
        "EVENT_CONSUMER_PUBSUB_NAME": "async-events-pubsub",
        "EVENT_CONSUMER_TOPIC": "async-events-v1.fifo",
        "EVENT_CONSUMER_RELAY_BATCH_SIZE": "10",
        "EVENT_CONSUMER_IDLE_SLEEP_SECONDS": "1"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "event_id", "request_id", "route", "status_code"]
    },
    "backfill_worker": {
      "timeout_seconds": 60,
      "env": {
        "BACKFILL_DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "BACKFILL_BATCH_SIZE": "1000",
        "BACKFILL_SLEEP_MS": "0",
        "BACKFILL_MAX_BATCHES": "1"
      },
      "expected_success_event": "backfill_complete",
      "expected_log_fields": ["event", "job_name"]
    },
    "data_export_job": {
      "timeout_seconds": 60,
      "env": {
        "DATA_EXPORT_DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "DATA_EXPORT_OUTPUT_DIR": "/exports",
        "DATA_EXPORT_RUN_ID": "conformance",
        "DATA_EXPORT_DATE": "2026-05-13",
        "DATA_EXPORT_S3_BUCKET": ""
      },
      "expected_success_event": "data_export_succeeded",
      "expected_log_fields": ["event", "job_name", "dataset", "run_id", "status"]
    },
    "open_dataset_pipeline": {
      "timeout_seconds": 60,
      "env": {
        "OPEN_DATASET_URL": "file:///app/apps/open_dataset_pipeline/sample_data/iris.csv",
        "OPEN_DATASET_NAME": "iris",
        "OPEN_DATASET_OUTPUT_DIR": "/exports",
        "OPEN_DATASET_RUN_ID": "conformance",
        "OPEN_DATASET_DATE": "2026-05-13"
      },
      "expected_success_event": "open_dataset_pipeline_succeeded",
      "expected_log_fields": ["event", "job_name", "dataset", "run_id", "status", "row_count"]
    }
  }
}
