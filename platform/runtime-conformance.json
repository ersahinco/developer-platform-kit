{
  "schema_version": "2",
  "defaults": {
    "env": {
      "DB_PORT": "5432",
      "DB_USER": "postgres",
      "DB_NAME": "aws_sdlc_containers"
    },
    "secrets": {
      "DB_PASSWORD": "runtime-secret://postgres-password"
    }
  },
  "workloads": {
    "api": {
      "startup_timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@pgbouncer:5432/aws_sdlc_containers",
        "OTEL_TRACES_ENABLED": "false",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://127.0.0.1:4318/v1/traces",
        "OTEL_SERVICE_NAME": "aws-sdlc-containers-api-conformance",
        "OTEL_DEPLOYMENT_ENVIRONMENT": "conformance"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "request_id", "route", "status_code"]
    },
    "event_consumer": {
      "startup_timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "DAPR_HTTP_ENDPOINT": "http://127.0.0.1:3500",
        "DAPR_HTTP_PORT": "3500",
        "ASYNC_EVENT_WORKER_MODE": "consumer",
        "ASYNC_EVENT_WORKER_RUN_ONCE": "false",
        "DAPR_PUBSUB_NAME": "async-events-pubsub",
        "DAPR_TOPIC": "async-events-v1.fifo",
        "DAPR_SUBSCRIPTION_ROUTE": "/internal/events/consume",
        "OUTBOX_RELAY_BATCH_SIZE": "10",
        "OUTBOX_RELAY_IDLE_SLEEP_SECONDS": "1"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "event_id", "request_id", "route", "status_code"]
    },
    "foreign_inventory_sync": {
      "startup_timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "request_id", "route", "status_code"]
    },
    "backfill_worker": {
      "timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "BACKFILL_BATCH_SIZE": "1000",
        "BACKFILL_SLEEP_MS": "0",
        "BACKFILL_MAX_BATCHES": "1"
      },
      "expected_success_event": "backfill_complete",
      "expected_log_fields": ["event", "job_name"]
    },
    "data_export_job": {
      "timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "DATA_EXPORT_OUTPUT_DIR": "/exports",
        "DATA_EXPORT_RUN_ID": "conformance",
        "DATA_EXPORT_DATE": "2026-05-13",
        "DATA_EXPORT_S3_BUCKET": ""
      },
      "expected_success_event": "data_export_succeeded",
      "expected_log_fields": ["event", "job_name", "dataset", "run_id", "status"]
    },
    "open_dataset_pipeline": {
      "timeout_seconds": 60,
      "env": {
        "OPEN_DATASET_URL": "file:///app/apps/open_dataset_pipeline/sample_data/iris.csv",
        "OPEN_DATASET_NAME": "iris",
        "OPEN_DATASET_OUTPUT_DIR": "/exports",
        "OPEN_DATASET_RUN_ID": "conformance",
        "OPEN_DATASET_DATE": "2026-05-13"
      },
      "expected_success_event": "open_dataset_pipeline_succeeded",
      "expected_log_fields": ["event", "job_name", "dataset", "run_id", "status", "row_count"]
    },
    "lake_orders_ingest_job": {
      "timeout_seconds": 120,
      "env": {
        "LAKE_ORDERS_SOURCE_DIR": "/app/apps/lake_orders_ingest_job/sample_data",
        "LAKE_ORDERS_OUTPUT_DIR": "/exports",
        "LAKE_ORDERS_RUN_ID": "conformance",
        "LAKE_ORDERS_INGEST_DATE": "2026-05-13"
      },
      "expected_success_event": "lake_orders_ingest_succeeded",
      "expected_log_fields": [
        "event",
        "job_name",
        "dataset",
        "run_id",
        "status",
        "row_count",
        "late_arrival_count",
        "parquet_object_count",
        "transform_tool",
        "transform_execution",
        "evidence_paths"
      ]
    },
    "churn_model_train_job": {
      "timeout_seconds": 60,
      "env": {
        "CHURN_TRAINING_DATA_PATH": "/app/apps/churn_model_train_job/sample_data/churn_training.csv",
        "CHURN_MODEL_OUTPUT_DIR": "/exports",
        "CHURN_MODEL_RUN_ID": "conformance",
        "CHURN_MODEL_TRAIN_DATE": "2026-05-13"
      },
      "expected_success_event": "churn_model_train_succeeded",
      "expected_log_fields": [
        "event",
        "job_name",
        "dataset",
        "run_id",
        "model_version",
        "status",
        "training_row_count",
        "metrics",
        "drift_summary",
        "evidence_paths"
      ]
    },
    "churn_prediction_api": {
      "startup_timeout_seconds": 60,
      "env": {
        "CHURN_MODEL_PATH": "/app/apps/churn_prediction_api/sample_model/churn_model.json"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "request_id", "route", "status_code"]
    },
    "support_triage_llm": {
      "startup_timeout_seconds": 60,
      "env": {
        "SUPPORT_TRIAGE_PROMPT_PATH": "/app/apps/support_triage_llm/prompts/support_triage_v1.md",
        "SUPPORT_TRIAGE_EVAL_CASES_PATH": "/app/apps/support_triage_llm/sample_data/evaluation_cases.json",
        "SUPPORT_TRIAGE_OUTPUT_DIR": "/exports"
      },
      "expected_log_event": "http_request",
      "expected_log_fields": ["event", "request_id", "route", "status_code"]
    },
    "operational_snapshot_job": {
      "timeout_seconds": 60,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
        "OPERATIONAL_SNAPSHOT_RUN_ID": "conformance"
      },
      "expected_success_event": "operational_snapshot_succeeded",
      "expected_log_fields": [
        "event",
        "job_name",
        "run_id",
        "status",
        "read_mode",
        "write_mode",
        "orders_count",
        "customers_count"
      ]
    },
    "integration_check_job": {
      "timeout_seconds": 60,
      "env": {
        "INTEGRATION_CHECK_TARGETS": "",
        "INTEGRATION_CHECK_TIMEOUT_SECONDS": "1",
        "INTEGRATION_CHECK_RUN_ID": "conformance",
        "INTEGRATION_CHECK_OUTPUT_DIR": "/tmp/integration-checks"
      },
      "expected_success_event": "integration_check_succeeded",
      "expected_log_fields": [
        "event",
        "job_name",
        "run_id",
        "status",
        "checked_count",
        "failed_count"
      ]
    }
  }
}
