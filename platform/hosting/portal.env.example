# Copy to ignored platform/.local/portal.env; chmod 600 that file.
# Supply client values through its secret store. Do not commit the filled file.
# Single-quote secrets to preserve literal $ characters. A PEM key can span
# multiple lines inside single quotes. See README for the integration contract.
PORTAL_IMAGE=registry.example.com/platform/backstage@sha256:REPLACE_WITH_DIGEST
PORTAL_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
SESSION_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_CREATORS_GROUP_ID=
ENTRA_VIEWERS_GROUP_ID=
ENTRA_CREATORS_GROUP_REF=
ENTRA_VIEWERS_GROUP_REF=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_ORGANIZATION=
TEMPLATES_CATALOG_URL=
# Optional: set BOTH when using GitHub Enterprise Server.
# GITHUB_HOST=github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3
# Private database CA: single-quoted PEM, including real line breaks.
# APP_CONFIG_backend_database_connection_ssl_ca='-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----'
