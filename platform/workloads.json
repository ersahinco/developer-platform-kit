{
  "schema_version": "1",
  "workloads": [
    {
      "name": "api",
      "kind": "service",
      "app_path": "apps/api",
      "package": "api",
      "image": {
        "repository": "app",
        "dockerfile": "apps/api/Dockerfile",
        "non_root_user": "app"
      },
      "http": {
        "health": "/health",
        "ready": "/ready",
        "metrics": "/metrics"
      },
      "logs": {
        "runtime_labels": ["stack", "environment", "service", "container"],
        "app_fields": ["event", "request_id"]
      },
      "metrics": {
        "format": "prometheus",
        "required_names": ["http_requests_total", "http_request_duration_seconds"]
      },
      "traces": {
        "supported": true,
        "protocol": "otlp_http"
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "transaction_pool",
        "runtime_secret": "DB_PASSWORD"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "OTEL_TRACES_ENABLED",
          "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
          "OTEL_SERVICE_NAME",
          "OTEL_DEPLOYMENT_ENVIRONMENT",
          "ROLLOUT_DRILL_FAULT_MODE",
          "ROLLOUT_DRILL_FAULT_PATHS",
          "ROLLOUT_DRILL_FAULT_STATUS_CODE",
          "ROLLOUT_DRILL_FAULT_DELAY_SECONDS"
        ],
        "secrets": ["DB_PASSWORD"],
        "runtime_config_keys": ["READ_MODE", "WRITE_MODE"]
      },
      "conformance": {
        "port": 8000,
        "startup_timeout_seconds": 60,
        "env": {
          "DATABASE_URL": "postgresql://postgres:postgres@pgbouncer:5432/aws_sdlc_containers",
          "DB_HOST": "pgbouncer",
          "DB_PORT": "5432",
          "DB_USER": "postgres",
          "DB_NAME": "aws_sdlc_containers",
          "OTEL_TRACES_ENABLED": "false",
          "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://127.0.0.1:4318/v1/traces",
          "OTEL_SERVICE_NAME": "aws-sdlc-containers-api-conformance",
          "OTEL_DEPLOYMENT_ENVIRONMENT": "conformance",
          "ROLLOUT_DRILL_FAULT_MODE": "off",
          "ROLLOUT_DRILL_FAULT_PATHS": "/ready",
          "ROLLOUT_DRILL_FAULT_STATUS_CODE": "503",
          "ROLLOUT_DRILL_FAULT_DELAY_SECONDS": "3"
        },
        "secrets": {
          "DB_PASSWORD": "runtime-secret://postgres-password"
        },
        "expected_log_event": "http_request",
        "expected_log_fields": ["event", "request_id", "route", "status_code"],
        "otlp_toggle": true
      },
      "rollback": "app_image",
      "release_evidence": ["deployment_id", "image_digest", "source_workflow", "verify_seconds"]
    },
    {
      "name": "order_event_consumer",
      "kind": "service",
      "app_path": "apps/order_event_consumer",
      "package": "order_event_consumer",
      "image": {
        "repository": "order-event-consumer",
        "dockerfile": "apps/order_event_consumer/Dockerfile",
        "non_root_user": "app"
      },
      "http": {
        "health": "/health",
        "ready": "/ready",
        "metrics": "/metrics"
      },
      "logs": {
        "runtime_labels": ["stack", "environment", "service", "container"],
        "app_fields": ["event", "event_id", "request_id"]
      },
      "metrics": {
        "format": "prometheus",
        "required_names": [
          "order_event_consumer_http_requests_total",
          "order_event_consumer_http_request_duration_seconds"
        ]
      },
      "traces": {
        "supported": false,
        "protocol": null
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct",
        "runtime_secret": "DB_PASSWORD"
      },
      "dapr": {
        "scope": "pubsub",
        "pubsub_name": "order-events-pubsub",
        "topic": "order-created-v1.fifo",
        "subscription_route": "/internal/events/order-created"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "DAPR_HTTP_ENDPOINT",
          "ORDER_EVENTS_APP_PORT",
          "ORDER_EVENTS_WORKER_MODE",
          "ORDER_EVENTS_PUBSUB_NAME",
          "ORDER_EVENTS_TOPIC",
          "ORDER_EVENTS_RELAY_BATCH_SIZE",
          "ORDER_EVENTS_IDLE_SLEEP_SECONDS"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "conformance": {
        "port": 8081,
        "startup_timeout_seconds": 60,
        "env": {
          "DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
          "DB_HOST": "db",
          "DB_PORT": "5432",
          "DB_USER": "postgres",
          "DB_NAME": "aws_sdlc_containers",
          "DAPR_HTTP_ENDPOINT": "http://127.0.0.1:3500",
          "ORDER_EVENTS_APP_PORT": "8081",
          "ORDER_EVENTS_WORKER_MODE": "consumer",
          "ORDER_EVENTS_PUBSUB_NAME": "order-events-pubsub",
          "ORDER_EVENTS_TOPIC": "order-created-v1.fifo",
          "ORDER_EVENTS_RELAY_BATCH_SIZE": "10",
          "ORDER_EVENTS_IDLE_SLEEP_SECONDS": "1"
        },
        "secrets": {
          "DB_PASSWORD": "runtime-secret://postgres-password"
        },
        "expected_log_event": "http_request",
        "expected_log_fields": ["event", "event_id", "request_id", "route", "status_code"]
      },
      "rollback": "app_image",
      "release_evidence": ["deployment_id", "image_digest", "source_workflow", "verify_seconds"]
    },
    {
      "name": "backfill_worker",
      "kind": "job",
      "app_path": "apps/backfill_worker",
      "package": "backfill_worker",
      "image": {
        "repository": "worker",
        "dockerfile": "apps/backfill_worker/Dockerfile",
        "non_root_user": "app"
      },
      "logs": {
        "runtime_labels": ["stack", "environment", "service", "container"],
        "app_fields": ["event", "job_name", "last_order_id"]
      },
      "traces": {
        "supported": false,
        "protocol": null
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct",
        "runtime_secret": "DB_PASSWORD"
      },
      "config": {
        "env": [
          "BACKFILL_DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "BACKFILL_BATCH_SIZE",
          "BACKFILL_SLEEP_MS",
          "BACKFILL_MAX_BATCHES"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "conformance": {
        "timeout_seconds": 60,
        "env": {
          "BACKFILL_DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
          "DB_HOST": "db",
          "DB_PORT": "5432",
          "DB_USER": "postgres",
          "DB_NAME": "aws_sdlc_containers",
          "BACKFILL_BATCH_SIZE": "1000",
          "BACKFILL_SLEEP_MS": "0",
          "BACKFILL_MAX_BATCHES": "1"
        },
        "secrets": {
          "DB_PASSWORD": "runtime-secret://postgres-password"
        },
        "expected_success_event": "backfill_complete",
        "expected_log_fields": ["event", "job_name"]
      },
      "job": {
        "idempotency": "checkpointed",
        "success_event": "backfill_complete",
        "progress_event": "backfill_batch"
      },
      "rollback": "idempotent_rerun_or_forward_fix",
      "release_evidence": ["source_workflow", "verify_seconds"]
    },
    {
      "name": "data_export_job",
      "kind": "job",
      "app_path": "apps/data_export_job",
      "package": "data_export_job",
      "image": {
        "repository": "data-export-job",
        "dockerfile": "apps/data_export_job/Dockerfile",
        "non_root_user": "app"
      },
      "logs": {
        "runtime_labels": ["stack", "environment", "service", "container"],
        "app_fields": ["event", "job_name", "dataset", "run_id", "status"]
      },
      "traces": {
        "supported": false,
        "protocol": null
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct",
        "runtime_secret": "DB_PASSWORD"
      },
      "config": {
        "env": [
          "DATA_EXPORT_DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "DATA_EXPORT_OUTPUT_DIR",
          "DATA_EXPORT_RUN_ID",
          "DATA_EXPORT_DATE",
          "DATA_EXPORT_S3_BUCKET"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "conformance": {
        "timeout_seconds": 60,
        "env": {
          "DATA_EXPORT_DATABASE_URL": "postgresql://postgres:postgres@db:5432/aws_sdlc_containers",
          "DB_HOST": "db",
          "DB_PORT": "5432",
          "DB_USER": "postgres",
          "DB_NAME": "aws_sdlc_containers",
          "DATA_EXPORT_OUTPUT_DIR": "/exports",
          "DATA_EXPORT_RUN_ID": "conformance",
          "DATA_EXPORT_DATE": "2026-05-13",
          "DATA_EXPORT_S3_BUCKET": ""
        },
        "secrets": {
          "DB_PASSWORD": "runtime-secret://postgres-password"
        },
        "expected_success_event": "data_export_succeeded",
        "expected_log_fields": ["event", "job_name", "dataset", "run_id", "status"]
      },
      "job": {
        "idempotency": "run_id",
        "success_event": "data_export_succeeded",
        "manifest_status": "succeeded"
      },
      "rollback": "idempotent_rerun_or_forward_fix",
      "release_evidence": ["source_workflow", "verify_seconds"]
    }
  ],
  "release_evidence": {
    "required_fields": [
      "schema_version",
      "event_type",
      "status",
      "summary",
      "timestamp",
      "runtime_id",
      "workload_id",
      "deployment_id",
      "image_digest",
      "rollback_category",
      "source_workflow",
      "evidence_links",
      "alarm_snapshot"
    ]
  }
}
