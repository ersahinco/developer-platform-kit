      },
      "config": {
        "env": [
          "LAKE_ORDERS_SOURCE_DIR",
          "LAKE_ORDERS_OUTPUT_DIR",
          "LAKE_ORDERS_RUN_ID",
          "LAKE_ORDERS_INGEST_DATE"
        ],
        "secrets": []
      },
      "job": {
        "idempotency": "run_id"
      }
    },
    {
      "name": "churn_model_train_job",
      "kind": "job",
