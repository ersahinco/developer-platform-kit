{
  "schema_version": "5",
  "workloads": [
    {
      "name": "api",
      "kind": "service",
      "use_cases": ["http-api"],
      "app_path": "apps/api",
      "operational": {
        "class": "edge-service",
        "exposure": "public"
      },
      "service": {
        "port": 8000
      },
      "image": {
        "repository": "api",
        "package": "aws-sdlc-containers-api",
        "command": "uvicorn api.main:app --host 0.0.0.0 --port 8000"
      },
      "metrics": {
        "format": "prometheus",
        "required_names": ["http_requests_total", "http_request_duration_seconds"]
      },
      "traces": {
        "supported": true
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "transaction_pool"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "OTEL_TRACES_ENABLED",
          "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
          "OTEL_SERVICE_NAME",
          "OTEL_DEPLOYMENT_ENVIRONMENT",
          "ROLLOUT_DRILL_FAULT_MODE",
          "ROLLOUT_DRILL_FAULT_PATHS",
          "ROLLOUT_DRILL_FAULT_STATUS_CODE",
          "ROLLOUT_DRILL_FAULT_DELAY_SECONDS"
        ],
        "secrets": ["DB_PASSWORD"]
      }
    },
    {
      "name": "order_event_consumer",
      "kind": "service",
      "use_cases": ["event-consumer", "integration"],
      "app_path": "apps/order_event_consumer",
      "operational": {
        "class": "internal-service",
        "exposure": "internal"
      },
      "service": {
        "port": 8081
      },
      "image": {
        "repository": "order-event-consumer",
        "package": "aws-sdlc-containers-order-event-consumer",
        "command": "python -m order_event_consumer.main"
      },
      "metrics": {
        "format": "prometheus",
        "required_names": [
          "order_event_consumer_http_requests_total",
          "order_event_consumer_http_request_duration_seconds"
        ]
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct"
      },
      "dapr": {
        "app_id": "order-event-consumer",
        "scope": "pubsub",
        "pubsub_name": "order-events-pubsub",
        "topic": "order-created-v1.fifo",
        "subscription_route": "/internal/events/order-created"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "DAPR_HTTP_ENDPOINT",
          "DAPR_HTTP_PORT",
          "ORDER_EVENTS_APP_PORT",
          "ORDER_EVENTS_WORKER_MODE",
          "ORDER_EVENTS_WORKER_RUN_ONCE",
          "ORDER_EVENTS_PUBSUB_NAME",
          "ORDER_EVENTS_TOPIC",
          "ORDER_EVENTS_RELAY_BATCH_SIZE",
          "ORDER_EVENTS_IDLE_SLEEP_SECONDS"
        ],
        "secrets": ["DB_PASSWORD"]
      }
    },
    {
      "name": "backfill_worker",
      "kind": "job",
      "use_cases": ["data-maintenance", "operator-task"],
      "app_path": "apps/backfill_worker",
      "operational": {
        "class": "operator-job",
        "trigger": "manual"
      },
      "image": {
        "repository": "backfill-worker",
        "package": "aws-sdlc-containers-backfill-worker",
        "command": "python -m backfill_worker.main"
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct"
      },
      "config": {
        "env": [
          "BACKFILL_DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "BACKFILL_BATCH_SIZE",
          "BACKFILL_SLEEP_MS",
          "BACKFILL_MAX_BATCHES"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "job": {
        "idempotency": "checkpointed"
      }
    },
    {
      "name": "data_export_job",
      "kind": "job",
      "use_cases": ["data-export", "scheduled-pipeline"],
      "app_path": "apps/data_export_job",
      "operational": {
        "class": "scheduled-job",
        "trigger": "schedule"
      },
      "image": {
        "repository": "data-export-job",
        "package": "aws-sdlc-containers-data-export-job",
        "command": "python -m data_export_job.main"
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct"
      },
      "config": {
        "env": [
          "DATA_EXPORT_DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "DATA_EXPORT_OUTPUT_DIR",
          "DATA_EXPORT_RUN_ID",
          "DATA_EXPORT_DATE",
          "DATA_EXPORT_S3_BUCKET"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "job": {
        "idempotency": "run_id"
      }
    }
  ]
}
