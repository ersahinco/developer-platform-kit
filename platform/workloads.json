{
  "schema_version": "8",
  "workloads": [
    {
      "name": "api",
      "kind": "service",
      "use_cases": ["http-api"],
      "owner": "platform-engineering",
      "app_path": "apps/api",
      "runtime": {
        "supported": ["local-compose", "local-kubernetes", "aws-ecs"],
        "admitted": ["aws-ecs"]
      },
      "operational": {
        "class": "edge-service",
        "exposure": "public"
      },
      "service": {
        "port": 8000
      },
      "edge": {
        "hostname_label": "api",
        "hostname_label_convention": "explicit-label",
        "auth_mode": "static-bearer-token"
      },
      "verification": {
        "profile": "primary-edge-runtime-modes",
        "runtime_mode_endpoints": {
          "read": "/admin/read-mode",
          "write": "/admin/write-mode"
        }
      },
      "image": {
        "repository": "api",
        "package": "aws-sdlc-containers-api",
        "command": "uvicorn api.main:app --host 0.0.0.0 --port 8000"
      },
      "metrics": {
        "format": "prometheus",
        "required_names": [
          "workload_info",
          "http_requests_total",
          "http_request_duration_seconds"
        ]
      },
      "traces": {
        "supported": true
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "transaction_pool"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "OTEL_TRACES_ENABLED",
          "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
          "OTEL_SERVICE_NAME",
          "OTEL_DEPLOYMENT_ENVIRONMENT"
        ],
        "secrets": ["DB_PASSWORD", "PRIMARY_EDGE_AUTH_TOKEN"]
      }
    },
    {
      "name": "booking_api",
      "kind": "service",
      "use_cases": [
        "booking",
        "concurrency-control",
        "consistency-proof",
        "service-to-service"
      ],
      "owner": "platform-engineering",
      "app_path": "apps/booking_api",
      "runtime": {
        "supported": ["local-compose"],
        "admitted": []
      },
      "operational": {
        "class": "internal-service",
        "exposure": "internal"
      },
      "service": {
        "port": 8084
      },
      "image": {
        "repository": "booking-api",
        "package": "aws-sdlc-containers-booking-api",
        "command": "python -m booking_api.main"
      },
      "metrics": {
        "format": "prometheus",
        "required_names": [
          "workload_info",
          "booking_api_http_requests_total",
          "booking_api_http_request_duration_seconds",
          "booking_attempts_total"
        ]
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "transaction_pool"
      },
      "dapr": {
        "app_id": "booking-api",
        "scope": "service-invocation"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "SERVICE_PORT"
        ],
        "secrets": ["DB_PASSWORD"]
      }
    },
    {
      "name": "event_consumer",
      "kind": "service",
      "use_cases": ["event-consumer", "integration"],
      "owner": "platform-engineering",
      "app_path": "apps/event_consumer",
      "runtime": {
        "supported": ["local-compose", "local-kubernetes", "aws-ecs"],
        "admitted": ["aws-ecs"]
      },
      "operational": {
        "class": "internal-service",
        "exposure": "internal"
      },
      "service": {
        "port": 8081
      },
      "image": {
        "repository": "event-consumer",
        "package": "aws-sdlc-containers-event-consumer",
        "command": "python -m event_consumer.main"
      },
      "metrics": {
        "format": "prometheus",
        "required_names": [
          "workload_info",
          "event_consumer_http_requests_total",
          "event_consumer_http_request_duration_seconds"
        ]
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct"
      },
      "dapr": {
        "app_id": "event-consumer",
        "scope": "pubsub",
        "pubsub_name": "async-events-pubsub",
        "topic": "async-events-v1.fifo",
        "subscription_route": "/internal/events/consume"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "DAPR_HTTP_ENDPOINT",
          "DAPR_HTTP_PORT",
          "ASYNC_EVENT_WORKER_MODE",
          "ASYNC_EVENT_WORKER_RUN_ONCE",
          "DAPR_PUBSUB_NAME",
          "DAPR_TOPIC",
          "DAPR_SUBSCRIPTION_ROUTE",
          "OUTBOX_RELAY_BATCH_SIZE",
          "OUTBOX_RELAY_IDLE_SLEEP_SECONDS"
        ],
        "secrets": ["DB_PASSWORD"]
      }
    },
    {
      "name": "backfill_worker",
      "kind": "job",
      "use_cases": ["data-maintenance", "operator-task"],
      "owner": "platform-engineering",
      "app_path": "apps/backfill_worker",
      "runtime": {
        "supported": ["local-compose", "local-kubernetes", "aws-ecs"],
        "admitted": ["aws-ecs"]
      },
      "operational": {
        "class": "operator-job",
        "trigger": "manual"
      },
      "image": {
        "repository": "backfill-worker",
        "package": "aws-sdlc-containers-backfill-worker",
        "command": "python -m backfill_worker.main"
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "BACKFILL_BATCH_SIZE",
          "BACKFILL_SLEEP_MS",
          "BACKFILL_MAX_BATCHES"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "job": {
        "idempotency": "checkpointed"
      }
    },
    {
      "name": "data_export_job",
      "kind": "job",
      "use_cases": ["data-export", "scheduled-pipeline"],
      "owner": "platform-engineering",
      "app_path": "apps/data_export_job",
      "runtime": {
        "supported": ["local-compose", "local-kubernetes", "aws-ecs"],
        "admitted": ["aws-ecs"]
      },
      "operational": {
        "class": "scheduled-job",
        "trigger": "schedule"
      },
      "image": {
        "repository": "data-export-job",
        "package": "aws-sdlc-containers-data-export-job",
        "command": "python -m data_export_job.main"
      },
      "traces": {
        "supported": false
      },
      "database": {
        "semantics": "postgresql",
        "pooling": "direct"
      },
      "config": {
        "env": [
          "DATABASE_URL",
          "DB_HOST",
          "DB_PORT",
          "DB_USER",
          "DB_NAME",
          "DATA_EXPORT_OUTPUT_DIR",
          "DATA_EXPORT_RUN_ID",
          "DATA_EXPORT_DATE",
          "DATA_EXPORT_S3_BUCKET"
        ],
        "secrets": ["DB_PASSWORD"]
      },
      "job": {
        "idempotency": "run_id"
      }
    },
    {
      "name": "lake_orders_ingest_job",
