# Keep root-context Docker builds focused and free of local state.

.git/
.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.codex/
.vscode/
.idea/
.kiro/

# Local environment and credentials
.env
.env.*
aws_credentials
.aws/

# Terraform state and plans must never enter Docker build context.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
*.tfplan
crash.log

# Local runtime noise
*.log
*.pid
*.swp
*~
.logs.txt
compose.override.yaml
compose.override.yml
compose.*.yaml
compose.*.yml
!compose.yaml
docker-compose.override.yml
