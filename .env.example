POSTGRES_DB=migration_example
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_PORT=8000
READ_MODE=legacy
WRITE_MODE=legacy
BACKFILL_BATCH_SIZE=1000
BACKFILL_SLEEP_MS=100
DATABASE_URL=postgresql://postgres:postgres@db:5432/migration_example
# Seed volume — override for QA/staging (e.g. SEED_NUM_ORDERS=1000000)
SEED_NUM_CUSTOMERS=1000
SEED_NUM_ORDERS=10000
