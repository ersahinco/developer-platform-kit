POSTGRES_DB=aws_sdlc_containers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
APP_PORT=8000
# App connects via pgbouncer (transaction pool) — not directly to Postgres.
DATABASE_URL=postgresql://postgres:postgres@pgbouncer:5432/aws_sdlc_containers
# Worker connects directly to Postgres — backfill uses long transactions
# incompatible with pgbouncer transaction mode.
# Inside Docker use db:5432; on the host use localhost:5432.
BACKFILL_DATABASE_URL=postgresql://postgres:postgres@db:5432/aws_sdlc_containers
# Data export job also connects directly to Postgres. It writes to /exports in
# Docker Compose, backed by the data_exports volume.
DATA_EXPORT_DATABASE_URL=postgresql://postgres:postgres@db:5432/aws_sdlc_containers
DATA_EXPORT_OUTPUT_DIR=/exports
# Seed volume — override for dev/staging (e.g. SEED_NUM_ORDERS=1000000)
SEED_NUM_CUSTOMERS=1000
SEED_NUM_ORDERS=10000
BACKFILL_BATCH_SIZE=1000
BACKFILL_SLEEP_MS=100

# Optional local observability profile.
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_OTLP_GRPC_PORT=4317
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
